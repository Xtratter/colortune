#!/usr/bin/env python3
"""colortune: gamma/saturation sliders for KDE Plasma (Wayland) via a generated ICC profile.

Usage:
  colortune            open the GUI
  colortune --apply    apply the saved settings and exit (no GUI)
  colortune --version
"""
__version__ = '1.0.0'

import json, os, shutil, struct, subprocess, sys
from PyQt5.QtCore import Qt, QTimer
from PyQt5.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel,
                             QSlider, QPushButton, QComboBox)

ICC_DIR = os.path.expanduser('~/.local/share/icc')
CFG = os.path.expanduser('~/.config/colortune.json')
M = [[0.4360747,0.3850649,0.1430804],[0.2225045,0.7168786,0.0606169],[0.0139322,0.0971045,0.7141733]]
LW = [0.2225045,0.7168786,0.0606169]

def inv(m):
    a,b,c=m[0];d,e,f=m[1];g,h,i=m[2]
    det=a*(e*i-f*h)-b*(d*i-f*g)+c*(d*h-e*g)
    return [[(e*i-f*h)/det,(c*h-b*i)/det,(b*f-c*e)/det],[(f*g-d*i)/det,(a*i-c*g)/det,(c*d-a*f)/det],[(d*h-e*g)/det,(b*g-a*h)/det,(a*e-b*d)/det]]
def mul(x,y): return [[sum(x[i][k]*y[k][j] for k in range(3)) for j in range(3)] for i in range(3)]
def s15(x): return struct.pack('>i', int(round(x*65536)))
def xyz(v): return b'XYZ \0\0\0\0' + b''.join(s15(x) for x in v)
def dec(e): return e/12.92 if e <= 0.04045 else ((e+0.055)/1.055)**2.4

def make_icc(gamma, sat, path):
    S = [[(1-sat)*LW[j]+(sat if i==j else 0) for j in range(3)] for i in range(3)]
    P = mul(M, inv(S))
    col = lambda j: [P[i][j] for i in range(3)]
    N = 1024
    vals = [dec((k/(N-1))**gamma) for k in range(N)]
    trc = b'curv\0\0\0\0'+struct.pack('>I',N)+b''.join(struct.pack('>H',int(round(min(max(v,0),1)*65535))) for v in vals)
    t = f'colortune gamma {gamma:.2f} sat {sat:.2f}'.encode()+b'\0'
    desc = b'desc\0\0\0\0'+struct.pack('>I',len(t))+t+b'\0'*78
    cprt = b'text\0\0\0\0public domain\0'
    tags = [('desc',desc),('cprt',cprt),('wtpt',xyz([0.9642,1.0,0.8249])),
            ('rXYZ',xyz(col(0))),('gXYZ',xyz(col(1))),('bXYZ',xyz(col(2))),
            ('rTRC',trc),('gTRC',None),('bTRC',None)]
    off = 132+12*len(tags); body = b''; table = b''; offs = {}
    for name, data in tags:
        if data is None:
            table += name.encode()+struct.pack('>II',*offs['rTRC']); continue
        offs[name] = (off+len(body), len(data))
        table += name.encode()+struct.pack('>II',*offs[name])
        body += data+b'\0'*((-len(data))%4)
    hdr = struct.pack('>I4sI4s4s4s',off+len(body),b'',0x02200000,b'mntr',b'RGB ',b'XYZ ')
    hdr += struct.pack('>6H',2026,1,1,0,0,0)+b'acsp'+b'\0'*32
    hdr += s15(0.9642)+s15(1.0)+s15(0.8249)
    hdr = hdr.ljust(128, b'\0')
    with open(path,'wb') as f: f.write(hdr+struct.pack('>I',len(tags))+table+body)

def outputs():
    try:
        out = subprocess.run(['kscreen-doctor','-o'],capture_output=True,text=True).stdout
    except Exception: return ['eDP-1']
    import re
    out = re.sub(r'\x1b\[[0-9;]*m','',out)
    names = re.findall(r'^Output: \d+ (\S+)', out, re.M)
    return names or ['eDP-1']

class W(QWidget):
    def __init__(self):
        super().__init__()
        self.setWindowTitle('Colortune')
        try: cfg = json.load(open(CFG))
        except Exception: cfg = {}
        self.flip = 0
        lay = QVBoxLayout(self)
        self.out = QComboBox(); self.out.addItems(outputs())
        if cfg.get('output') in [self.out.itemText(i) for i in range(self.out.count())]:
            self.out.setCurrentText(cfg['output'])
        lay.addWidget(self.out)
        self.g = self.row(lay, 'Гамма', 50, 150, int(cfg.get('gamma',1.0)*100), 100)
        self.s = self.row(lay, 'Насыщенность', 0, 200, int(cfg.get('sat',1.0)*100), 100)
        bl = QHBoxLayout()
        rb = QPushButton('Сброс (sRGB)'); rb.clicked.connect(self.reset)
        bl.addWidget(rb); lay.addLayout(bl)
        self.timer = QTimer(self, singleShot=True, interval=150, timeout=self.apply)
        self.resize(380, 0)

    def row(self, lay, name, lo, hi, val, default):
        h = QHBoxLayout(); lab = QLabel(); lab.setMinimumWidth(170)
        sl = QSlider(Qt.Horizontal); sl.setRange(lo, hi); sl.setValue(val)
        sl.valueChanged.connect(lambda v: (lab.setText(f'{name}: {v/100:.2f}'), self.timer.start()))
        lab.setText(f'{name}: {val/100:.2f}')
        h.addWidget(lab); h.addWidget(sl)
        for sign, d in (('−', -1), ('+', 1)):
            b = QPushButton(sign); b.setFixedWidth(32); b.setAutoRepeat(True)
            b.clicked.connect(lambda _, d=d: sl.setValue(sl.value()+d))
            h.addWidget(b)
        lay.addLayout(h)
        sl.default = default; return sl

    def apply(self):
        gamma, sat, o = self.g.value()/100, self.s.value()/100, self.out.currentText()
        os.makedirs(ICC_DIR, exist_ok=True)
        self.flip ^= 1
        path = os.path.join(ICC_DIR, f'colortune-{self.flip}.icc')  # new path each time forces KWin reload
        make_icc(gamma, sat, path)
        subprocess.run(['kscreen-doctor', f'output.{o}.iccprofile.{path}', f'output.{o}.colorProfileSource.ICC'])
        json.dump({'gamma':gamma,'sat':sat,'output':o}, open(CFG,'w'))

    def reset(self):
        self.g.setValue(100); self.s.setValue(100)
        subprocess.run(['kscreen-doctor', f'output.{self.out.currentText()}.colorProfileSource.sRGB'])
        self.timer.stop()

if __name__ == '__main__':
    if '--version' in sys.argv:
        print(f'colortune {__version__}'); sys.exit(0)
    if '-h' in sys.argv or '--help' in sys.argv:
        print(__doc__); sys.exit(0)
    if not shutil.which('kscreen-doctor'):
        sys.exit('colortune: kscreen-doctor not found (install libkscreen / KDE Plasma 6)')
    app = QApplication(sys.argv)
    if '--apply' in sys.argv:   # apply saved settings without GUI
        w = W(); w.apply(); sys.exit(0)
    w = W(); w.show(); sys.exit(app.exec_())
